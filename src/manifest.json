{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "name": "DuckDuckGo Custom Tabs",
  "description": "Customize DuckDuckGo search tabs by redirecting maps, videos, and other sections to your preferred services.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "DuckDuckGo Custom Tabs"
  },
  "firefox:browser_action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "DuckDuckGo Custom Tabs"
  },
  "chromium:permissions": ["storage"],
  "firefox:permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "duckduckgo-custom-tabs@dvct.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://duckduckgo.com/*"],
      "js": ["content/index.ts"]
    }
  ],
  "author": "David Vicente"
}
