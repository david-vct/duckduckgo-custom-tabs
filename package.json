{
  "private": true,
  "name": "duckduckgo-custom-tabs",
  "description": "Customize DuckDuckGo search tabs by redirecting maps, videos, and other sections to your preferred services.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "David Vicente"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/david-vct/duckduckgo-custom-tabs.git"
  },
  "scripts": {
    "dev": "extension dev --browser=firefox",
    "start": "extension start",
    "build": "extension build",
    "preview": "extension preview",
    "test": "node --test",
    "build:chrome": "extension build --browser chrome",
    "build:firefox": "extension build --browser firefox",
    "build:edge": "extension build --browser edge",
    "release:chrome": "extension build --browser chrome --zip --zip-filename duckduckgo-custom-tabs-$npm_package_version-chrome",
    "release:firefox": "extension build --browser firefox --zip --zip-filename duckduckgo-custom-tabs-$npm_package_version-firefox",
    "release": "npm run release:chrome && npm run release:firefox"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chrome": "^0.1.27",
    "@types/node": "^24.5.2",
    "extension": "^3.10.1",
    "typescript": "^5.9.2"
  },
  "packageManager": "npm@11.9.0"
}
